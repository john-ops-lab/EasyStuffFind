# Ordinary configuration only. The API token is generated under the data directory.
EASYSTUFFFIND_DATA_DIR=data
EASYSTUFFFIND_HOST=0.0.0.0
EASYSTUFFFIND_PORT=8733
EASYSTUFFFIND_LOG_LEVEL=INFO

# preflight.py writes the current macOS user IDs to the ignored local .env.
EASYSTUFFFIND_UID=501
EASYSTUFFFIND_GID=20
